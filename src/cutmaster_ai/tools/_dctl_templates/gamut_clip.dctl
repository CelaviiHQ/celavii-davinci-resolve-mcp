// Gamut-clip DCTL — clips RGB into [0, max] with optional desaturate.
// Useful as a last-stop node before deliver to avoid out-of-gamut shipping.
// CutMaster AI · v5 Wave 3 · template id: gamut_clip

DEFINE_UI_PARAMS(ceiling, Ceiling, DCTLUI_SLIDER_FLOAT, 1.0, 0.5, 4.0, 0.001)
DEFINE_UI_PARAMS(desat, Desaturate, DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 1.0, 0.001)

__DEVICE__ float clamp01_ceiling(float c, float k)
{
    if (c < 0.0f) return 0.0f;
    if (c > k) return k;
    return c;
}

__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y, float p_R, float p_G, float p_B)
{
    float lum = 0.2126f * p_R + 0.7152f * p_G + 0.0722f * p_B;
    float r = p_R * (1.0f - desat) + lum * desat;
    float g = p_G * (1.0f - desat) + lum * desat;
    float b = p_B * (1.0f - desat) + lum * desat;
    return make_float3(
        clamp01_ceiling(r, ceiling),
        clamp01_ceiling(g, ceiling),
        clamp01_ceiling(b, ceiling)
    );
}
